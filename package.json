{
  "name": "ervisio-todo",
  "version": "0.3.0",
  "private": true,
  "description": "ErvisioTodo \u2014 standalone task management extracted from FusionHub",
  "engines": {
    "node": ">=24.13 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build --webpack && node scripts/prepare-standalone.mjs",
    "start": "node --env-file=.env scripts/start.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "setup": "node scripts/setup.mjs",
    "backup": "node --env-file=.env scripts/backup.mjs",
    "docs:api": "node scripts/generate-openapi.mjs && prettier --write docs/openapi.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:docker": "node tests/docker-smoke.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-brands-svg-icons": "^7.2.0",
    "@fortawesome/free-regular-svg-icons": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@fortawesome/react-fontawesome": "^3.2.0",
    "@hookform/resolvers": "^5.2.2",
    "bcryptjs": "^3.0.3",
    "next": "16.4.4",
    "next-auth": "5.0.0-beta.32",
    "nodemailer": "^10.3.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.71.2",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "swr": "^2.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^7.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.24",
    "postcss": "^8.5.6",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "nodemailer": "$nodemailer",
    "postcss-selector-parser": "^6.1.5"
  }
}
