# Node >=24.13 <25. AUTH_SECRET: almeno 32 caratteri, generarlo con npm run setup (anche la build lo richiede).
AUTH_SECRET=
AUTH_URL=http://localhost:3000
DATA_DIR=./data
# Binding del comando npm start (il container usa 0.0.0.0 internamente).
BIND_HOST=127.0.0.1
# Dominio sotto il proprio controllo; vuoto disabilita i sottodomini.
BASE_DOMAIN=
# Necessario per SSO tra host canonico e liste. Esempio: .example.com
AUTH_COOKIE_DOMAIN=
# Attivare solo dietro Caddy che sovrascrive X-Real-IP.
TRUSTED_IP_HEADER=
AUTH_LOCAL_ENABLED=true
REGISTRATION_ENABLED=true
REQUIRE_EMAIL_VERIFICATION=false
AUTH_GOOGLE_ENABLED=false
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_DISCORD_ENABLED=false
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=
AUTH_COGNITO_ENABLED=false
AUTH_COGNITO_ID=
AUTH_COGNITO_SECRET=
# Issuer User Pool, NON dominio Managed Login
AUTH_COGNITO_ISSUER=
# Esempio smtps://user:password@smtp.example.com:465 (URL-encode credenziali)
SMTP_URL=
MAIL_FROM=ErvisioTodo <noreply@example.com>
# Facoltativo: servizio di generazione compatibile chat/completions, configurato dal gestore.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Valori iniziali limiti allegati (le impostazioni amministrative possono sovrascriverli)
UPLOAD_MAX_MB=10
STORAGE_QUOTA_GB=0
UPLOAD_REQUEST_MAX_MB=512
